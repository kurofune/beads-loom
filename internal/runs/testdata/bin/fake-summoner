#!/bin/sh
# A stand-in for the real summoner binary, used by the process-manager tests.
#
# Behaviour is driven by FAKE_SUMMONER_MODE:
#   dry-run   print bead ids on stdout and a summary on stderr, exit 0
#   long      emit console-shaped lines, then sleep until signalled
#   ignore    trap SIGTERM and keep running, to exercise the SIGKILL path
#   fail      exit non-zero
# Default: print the argv it received and exit 0.

echo "fake-summoner argv: $*" >&2

case "${FAKE_SUMMONER_MODE:-default}" in
  dry-run)
    printf 'djinn-aaaa\ndjinn-bbbb\n'
    echo "summoner: --dry-run: 2 bead(s) would be dispatched for this scope" >&2
    echo "summoner: requested bead djinn-nope is not in the ready set (unknown or not ready); skipping" >&2
    ;;
  preflight)
    printf 'djinn-aaaa\ndjinn-bbbb\n'
    echo "summoner: bead djinn-bbbb has operator-required criteria" >&2
    ;;
  long)
    echo "summoner: polling bd ready every 30s, max 1 workers"
    printf '\033[32m\033[1m\xe2\x9c\x85 Done [implement] (cost: $1.5000, ctx: 8%%, dur=1m0s)\033[0m\n'
    printf '\033[32m\033[1m\xe2\x9c\x85 Done [verify-impl iter 1/3] (cost: $0.5000, ctx: 5%%, dur=30s)\033[0m\n'
    trap 'exit 0' TERM INT
    echo "fake-summoner: trap installed"
    # Sleep in short slices so the trap fires promptly.
    i=0
    while [ "$i" -lt 600 ]; do sleep 0.1; i=$((i+1)); done
    ;;
  ignore)
    trap '' TERM INT
    # Announce readiness AFTER the trap is installed, so a test can wait for
    # this line rather than racing the shell's startup.
    echo "fake-summoner: trap installed"
    i=0
    while [ "$i" -lt 600 ]; do sleep 0.1; i=$((i+1)); done
    ;;
  fail)
    echo "summoner: scope error: no such epic" >&2
    exit 2
    ;;
  *)
    echo "fake-summoner done"
    ;;
esac
